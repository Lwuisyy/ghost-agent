# Ghost Agent — Environment Configuration

# === Proxy Configuration ===
# Comma-separated proxy list (format: protocol://user:pass@host:port)
PROXY_LIST=
# Or use a proxy provider API endpoint
PROXY_API_URL=
# Proxy rotation strategy: round-robin | random | least-used | geo-target
PROXY_STRATEGY=round-robin
# Max retries when a proxy fails
PROXY_MAX_RETRIES=3
# Proxy health check interval (ms)
PROXY_HEALTH_CHECK_INTERVAL=30000

# === CAPTCHA Solving ===
# Provider: 2captcha | anti-captcha | capsolver | hcaptcha-token
CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY=

# === Session Configuration ===
# Max concurrent sessions
MAX_SESSIONS=10
# Session TTL (ms)
SESSION_TTL=300000
# Enable cookie persistence across session restarts
COOKIE_PERSIST=false

# === Rate Limiting ===
# Min delay between requests (ms)
RATE_LIMIT_MIN_DELAY=1000
# Max delay between requests (ms)
RATE_LIMIT_MAX_DELAY=5000
# Enable human-like delay jitter
HUMAN_JITTER=true

# === Logging ===
# Level: trace | debug | info | warn | error
LOG_LEVEL=info
