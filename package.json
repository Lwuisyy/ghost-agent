{
  "name": "ghost-agent",
  "version": "0.1.0",
  "description": "Anti-detection infrastructure for AI agents — proxy rotation, browser fingerprinting, session management, and CAPTCHA solving",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src/",
    "example:scrape": "tsx examples/web-scraping-agent.ts",
    "example:api": "tsx examples/api-testing-agent.ts"
  },
  "keywords": [
    "ai-agent",
    "anti-detection",
    "proxy-rotation",
    "browser-fingerprint",
    "captcha-solver",
    "web-scraping",
    "stealth"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "undici": "^7.3.0",
    "tough-cookie": "^5.1.0",
    "proxy-chain": "^2.0.0",
    "fingerprint-generator": "^2.1.0",
    "header-generator": "^2.1.0",
    "pino": "^9.6.0",
    "dotenv": "^16.4.0",
    "zod": "^3.24.0",
    "nanoid": "^5.1.0",
    "eventemitter3": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/tough-cookie": "^4.0.0",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
